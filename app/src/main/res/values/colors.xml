<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Adaptive launcher-icon background — white to match the iOS AppIcon field
         (navy "D" mark on white). Replaces the Android Studio placeholder green. -->
    <color name="ic_launcher_background">#FFFFFFFF</color>
    <!-- Brand gold — used as FCM default_notification_color so system-displayed
         notifications carry the brand accent instead of the OS default grey (R8a).
         Matches DestinyTheme GoldGradient mid-stop (#F5D060). -->
    <color name="notification_accent_gold">#FFF5D060</color>
</resources>